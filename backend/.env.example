# Copy to .env and fill in. Never commit real keys.
#
# Local development: run `npm start` and copy the values it prints.
# Live project: Supabase dashboard → Project Settings → API Keys.

# Public — safe to use in the website (frontend).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Secret — server-side only (admin tasks such as inviting staff). Never put this in the frontend.
SUPABASE_SECRET_KEY=
