# Copy to .env.local and fill in. These values are public (safe in the browser).
#
# Live: Supabase dashboard → Project Settings → API Keys → "Publishable key".
NEXT_PUBLIC_SUPABASE_URL=https://hkvcwdvtgmniuqxvuqsv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public address of the website (used for links in search engines and sharing).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — server only (Vercel environment variable, never in the browser).
# Lets the staff dashboard invite staff and show their email addresses.
# Supabase dashboard → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Email alerts (new enquiries, care reports with a concern) — server only. Without these, nothing is emailed.
# Option 1: SMTP with nodemailer, e.g. the office Gmail account and a Google "App password"
# (Google Account → Security → 2-Step Verification → App passwords). Never the normal password.
SMTP_USER=
SMTP_PASS=
# Defaults: smtp.gmail.com on port 465. Change for another mail provider.
SMTP_HOST=
SMTP_PORT=
# Option 2: Resend (https://resend.com) instead of SMTP.
RESEND_API_KEY=
# Optional sender, e.g. "Chase Care Services <chasecareinfo@gmail.com>".
EMAIL_FROM=
